{
  "name": "smart-home-app",
  "version": "1.0.2",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android:release": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-release.ps1",
    "typecheck": "tsc --noEmit",
    "check:js": "node --check admin-site/audit.js && node --check admin-site/app.js && node --check project-site/app.js && node --check project-site/knowledge.js && node --check backend/forecast_api/server.js",
    "check:python": "python -m compileall -q backend research ml-training",
    "test:backend": "python -m unittest discover -s backend/smart_home_server/tests -v",
    "test:forecast": "python -m unittest discover -s backend/forecast_api/tests -p test_*.py -v && node --test backend/forecast_api/tests/sample_server_contract.test.js",
    "test:research": "python -m unittest discover -s research/tests -v",
    "test:frontend-contract": "node --test tests/frontend_contract.test.js",
    "test:admin-audit": "node --test tests/admin_audit.test.js",
    "test:room-presentation": "node --experimental-strip-types --test tests/room_presentation.test.mjs",
    "test": "npm run test:backend && npm run test:forecast && npm run test:research && npm run test:frontend-contract && npm run test:admin-audit && npm run test:room-presentation",
    "lint": "npm run typecheck && npm run check:js",
    "verify": "npm run lint && npm run check:python && npm test",
    "security:audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "expo": "~55.0.28",
    "expo-font": "~55.0.8",
    "expo-linear-gradient": "~55.0.15",
    "expo-print": "~55.0.16",
    "expo-secure-store": "~55.0.15",
    "expo-sharing": "~55.0.21",
    "expo-speech": "~55.0.15",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-chart-kit": "^6.12.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gifted-chat": "^2.6.5",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-voicekit": "^0.2.2",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
